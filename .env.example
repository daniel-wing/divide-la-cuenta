# API key from the pey portal. Without it the app runs in demo mode (fake QRs).
PEY_API_KEY=
# Webhook signing secret from the pey portal (Standard Webhooks, usually starts with whsec_)
PEY_WEBHOOK_SECRET=
# Set automatically when you connect Upstash Redis in Vercel > Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Waiter code. Without it the app uses the demo code 1234 and shows it on the unlock screen.
WAITER_PIN=
# Set to 1 to force demo mode (fake QRs, "Simular CoDi" button) even with a pey key.
DEMO_MODE=
